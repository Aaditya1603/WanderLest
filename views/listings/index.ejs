<% layout("/layouts/boilerplate") %>

<style>
    #filters {
        display: flex;
        flex-wrap: wrap;
        align-items: center; 
    }

    .filter {
        text-align: center;
        margin-right: 2rem;
        margin-top: 1rem;
        opacity: 0.7;
        transition: 0.2s; 
    }

    .filter:hover {
        opacity: 1;
        cursor: pointer;
    }

    .filter p {
        font-size: 0.8rem;
    }

    .tax-info {
        display: none;
    }

    .tax-toggle {
        border: 1px solid black;
        border-radius: 1rem;
        height: 3.25rem;
        padding: 1rem;
        margin-left: 2rem;
        display: flex;
        align-items: center;
    }
</style>

<div id="filters">
      <a href="/listings" class="filter">
        <div><i class="fa-solid fa-border-all"></i></div>
        <p>All</p>
    </a>
    <a href="/listings?category=Trending" class="filter">
        <div><i class="fa-solid fa-fire"></i></div>
        <p>Trending</p>
    </a>
     <a href="/listings?category=Rooms" class="filter">
        <div><i class="fa-solid fa-bed"></i></div>
        <p>Rooms</p>
    </a>
    <a href="/listings?category=Iconic Cities" class="filter">
        <div><i class="fa-solid fa-mountain-city"></i></div>
        <p>Iconic Cities</p>
    </a>
     <a href="/listings?category=Mountains" class="filter">
        <div><i class="fa-solid fa-mountain"></i></div>
        <p>Mountains</p>
    </a>
     <a href="/listings?category=Castles" class="filter">
        <div><i class="fa-solid fa-fort-awesome"></i></div>
        <p>Castles</p>
    </a>
     <a href="/listings?category=Amazing Pools" class="filter">
        <div><i class="fa-solid fa-person-swimming"></i></div>
        <p>Amazing Pools</p>
    </a>
    <a href="/listings?category=Camping" class="filter">
        <div><i class="fa-solid fa-tent"></i></div>
        <p>Camping</p>
    </a>
    <a href="/listings?category=Farms" class="filter">
        <div><i class="fa-solid fa-cow"></i></div>
        <p>Farms</p>
    </a>
     <a href="/listings?category=Arctic" class="filter">
        <div><i class="fa-solid fa-snowflake"></i></div>
        <p>Arctic</p>
    </a>
       <a href="/listings?category=Domes" class="filter">
        <div><i class="fa-solid fa-igloo"></i></div>
        <p>Domes</p>
    </a>
     <a href="/listings?category=Boats" class="filter">
        <div><i class="fa-solid fa-ship"></i></div>
        <p>Boats</p>
    </a>
     <div class="tax-toggle">
   <div class="form-check-reverse form-switch">
  <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
  <label class="form-check-label" for="switchCheckDefault">Display Total after Taxes</label>
    </div>
</div>
</div>
 <!-- 📊 Price Sorting Button -->
    <button id="price-filter-btn" class="btn btn-outline-danger btn-sm rounded-pill px-3">
        ₹ Sort by Price
    </button>

   <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
  <% for(let listing of allListings) { %>
     <!-- 1. Added data-price here to store the raw numerical value -->
     <a href="/listings/<%= listing._id %>" class="listing-link listing-card-wrapper" data-price="<%= listing.price %>">
       <div class="card col listing-card">
         <img src="<%= (listing.image && listing.image.url) ? listing.image.url : 'https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTh8fGxha2V8ZW58MHx8MHx8fDA%3D&auto=format&fit=crop&w=800&q=60' %>" class="card-img-top" alt="listing_image" style="height: 20rem" />
         <div class="card-img-overlay"></div>
         <div class="card-body">
           <p class="card-text">
             <b><%= listing.title %></b> <br />
             <!-- 2. Wrapped the base price in a span to swap it easily -->
             <span class="base-price">₹ <%= listing.price?.toLocaleString("en-IN") %> / night</span>
             <!-- 3. Wrapped the tax calculation total inside this hidden element -->
             <span class="tax-info text-danger" style="display: none;">
               &nbsp;&nbsp;₹ <%= (listing.price * 1.18).toLocaleString("en-IN") %> / night <small>(inc. 18% GST)</small>
             </span>
           </p>
         </div>
       </div>
     </a>
  <% } %>
</div>

 <script>
    let taxSwitch = document.getElementById("switchCheckDefault");

     taxSwitch.addEventListener("change", () => {
       let basePrices = document.getElementsByClassName("base-price");
       let taxInfos = document.getElementsByClassName("tax-info");
       
       for (let i = 0; i < basePrices.length; i++) {
           if (taxSwitch.checked) {
               basePrices[i].style.display = "none";
               taxInfos[i].style.display = "inline";
           } else {
               basePrices[i].style.display = "inline";
               taxInfos[i].style.display = "none";
            }
        }
    });
 </script>