<% layout("/layouts/boilerplate") %>
<div class="row">
    <div class="col-8 offset-2">
        <br /><br/>
    <h2 class="head1"><b>Create a New Listing</b></h2>
   <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
    <div class="mb-3">
    <lable for="title" class="form-label"><b>Title</b></lable>
    <input name="listing[title]" placeholder="Add a Catchy Title" type="text" class="form-control" required/>
    <div class="valid-feedback">Title looks Good!</div>
      </div>
 
    <div class="mb-3">
        <lable for="description" class="form-label"><b>Description</b></lable>
        <textarea name="listing[description]" class="form-control" required></textarea>
         <div class="invalid-feedback">Please enter a valid description</div>
    </div>

<div class="mb-3">
     <lable for="image" class="form-label"><b>Upload Image</b></lable>
       <input name="listing[image]" type="file" class="form-control" />
       required
    </div>

    <div class="row">
         <div class="mb-3 col-md-4">
    <lable for="price" class="form-label"><b>Price</b></lable>
    <input name="listing[price]" placeholder="1200" class="form-control" required />
    <div class="invalid-feedback">Please enter a valid Price</div>
 </div>
   
 <div class="mb-3 col-md-8">
    <lable for="country" class="form-label"><b>Country</b></lable>
    <input name="listing[country]" placeholder="India" type="text" class="form-control" required/>
     <div class="invalid-feedback">Please enter the valid country name</div>
 </div>
    </div>


   <div class="mb-3">
    <lable for="location" class="form-label"><b>Location</b></lable>
    <input name="listing[location]" placeholder="Jaipur, Rajasthan" type="text" class="form-control" required />
     <div class="invalid-feedback">Please enter the valid location</div>
    </div>

    <br /><br />
    <button class="btn btn-dark add-btn">Add</button>
    <br/><br/>
   </form>
   </div>
 </div>